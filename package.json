{
  "name": "trip-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/dev.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/prod.ts",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "dexie": "^4.4.7",
    "hono": "^4.13.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
